<?xml version="1.0" encoding="utf-8"?>
<!-- Volante stilizzato (indicatore, non realistico): anello + mozzo + 3 razze + tacca superiore.
     La tacca in alto rende evidente la rotazione applicata via setRotation() dalla view. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48px"
    android:height="48px"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- anello esterno -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:pathData="M24,4 A20,20 0 1,0 24.01,4 Z" />
    <!-- razze: sinistra, destra, basso -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="3" android:pathData="M8,24 L19,24" />
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="3" android:pathData="M29,24 L40,24" />
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="3" android:pathData="M24,29 L24,40" />
    <!-- mozzo centrale -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,19 A5,5 0 1,0 24.01,19 Z" />
    <!-- tacca superiore (riferimento posizione dritta) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,2 L20,9 L28,9 Z" />
</vector>
